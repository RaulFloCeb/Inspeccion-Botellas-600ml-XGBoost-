{
    "openapi": "3.1.0",
    "info": {
        "title": "Inspección de Botellas 600ml",
        "description": "Clasifica botellas como ACEPTADO o RECHAZADO por nivel de llenado y etiqueta.",
        "version": "1.0.0"
    },
    "paths": {
        "/health": {
            "get": {
                "summary": "Health",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/predict": {
            "post": {
                "summary": "Predict",
                "operationId": "predict_predict_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BottleInput"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PredictionOutput"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "BottleInput": {
                "properties": {
                    "fill_level_ml": {
                        "type": "number",
                        "maximum": 2000.0,
                        "minimum": 0.0,
                        "title": "Fill Level Ml",
                        "description": "Nivel de llenado en ml"
                    },
                    "label_present_num": {
                        "type": "integer",
                        "enum": [
                            0,
                            1
                        ],
                        "title": "Label Present Num",
                        "description": "1 = etiqueta presente, 0 = sin etiqueta"
                    }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                    "fill_level_ml",
                    "label_present_num"
                ],
                "title": "BottleInput",
                "examples": [
                    {
                        "fill_level_ml": 598.5,
                        "label_present_num": 1
                    }
                ]
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "PredictionOutput": {
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "ACEPTADO",
                            "RECHAZADO"
                        ],
                        "title": "Status"
                    },
                    "target": {
                        "type": "integer",
                        "enum": [
                            0,
                            1
                        ],
                        "title": "Target"
                    },
                    "probability_reject": {
                        "type": "number",
                        "title": "Probability Reject"
                    },
                    "threshold": {
                        "type": "number",
                        "title": "Threshold"
                    },
                    "rule_rejected": {
                        "type": "boolean",
                        "title": "Rule Rejected"
                    },
                    "model_rejected": {
                        "type": "boolean",
                        "title": "Model Rejected"
                    },
                    "rejection_reasons": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Rejection Reasons"
                    },
                    "model_version": {
                        "type": "string",
                        "title": "Model Version"
                    },
                    "inference_ms": {
                        "type": "number",
                        "title": "Inference Ms"
                    }
                },
                "type": "object",
                "required": [
                    "status",
                    "target",
                    "probability_reject",
                    "threshold",
                    "rule_rejected",
                    "model_rejected",
                    "rejection_reasons",
                    "model_version",
                    "inference_ms"
                ],
                "title": "PredictionOutput"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
